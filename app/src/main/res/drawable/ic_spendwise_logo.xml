<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Container Background Squircle -->
    <path
        android:pathData="M 58,16 L 142,16 A 42,42 0 0,1 184,58 L 184,142 A 42,42 0 0,1 142,184 L 58,184 A 42,42 0 0,1 16,142 L 16,58 A 42,42 0 0,1 58,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="180"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6366F1" />
                <item android:offset="0.5" android:color="#FF4F46E5" />
                <item android:offset="1.0" android:color="#FF1E1B4B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Card (Purple/Indigo) -->
    <path
        android:fillColor="#FFA78BFA"
        android:pathData="M 58,34 L 118,24 C 122,23 126,26 127,30 L 132,68 L 54,68 L 56,38 C 57,36 57,34 58,34 Z" />

    <!-- Top Card (Emerald) -->
    <path
        android:fillColor="#FF10B981"
        android:pathData="M 80,38 L 144,48 C 148,48 150,52 149,56 L 147,68 L 74,68 L 78,42 C 78,40 79,38 80,38 Z" />

    <!-- Wallet Body Base (Navy/Slate) -->
    <path
        android:fillColor="#FF0F172A"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M 56,70 L 144,70 C 154,70 162,78 162,88 L 162,144 C 162,154 154,162 144,162 L 56,162 C 46,162 38,154 38,144 L 38,88 C 38,78 46,70 56,70 Z" />

    <!-- 4 Ascending Financial Growth Bars -->
    <path
        android:fillColor="#8010B981"
        android:pathData="M 54,126 L 65,126 L 65,150 L 54,150 Z" />

    <path
        android:fillColor="#B310B981"
        android:pathData="M 71,114 L 82,114 L 82,150 L 71,150 Z" />

    <path
        android:fillColor="#FF10B981"
        android:pathData="M 88,98 L 99,98 L 99,150 L 88,150 Z" />

    <path
        android:fillColor="#FF38BDF8"
        android:pathData="M 105,86 L 116,86 L 116,150 L 105,150 Z" />

    <!-- Upward Trend Line -->
    <path
        android:strokeColor="#FFF8FAFC"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 52,120 L 76,104 L 93,112 L 120,78" />

    <!-- Arrowhead -->
    <path
        android:fillColor="#FFF8FAFC"
        android:strokeColor="#FFF8FAFC"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round"
        android:pathData="M 109,76 L 123,76 L 123,90 Z" />

    <!-- Wallet Clasp Tab -->
    <path
        android:fillColor="#FF1E293B"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M 148,102 C 158,102 164,108 164,116 C 164,124 158,130 148,130 Z" />

    <!-- Clasp Center Dot -->
    <path
        android:fillColor="#FF34D399"
        android:pathData="M 152,116 A 4.5,4.5 0 1,0 152,117 A 4.5,4.5 0 1,0 152,116 Z" />

</vector>
